<?php

/**
 * @file
 * Hook implementations for Daedalus Layout.
 */

use Drupal\Core\Breadcrumb\Breadcrumb;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\daedalus_layout\Form\OverridesEntityForm;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\daedalus_layout\Form\EntityViewDisplayForm;
use Drupal\daedalus_layout\InlineBlockEntityOperations;
use Drupal\daedalus_layout\Plugin\Block\SectionBlock;

/**
 * Implements hook_element_plugin_alter().
 */
function daedalus_layout_element_plugin_alter(array &$definitions) {
  $definitions['layout_builder']['class'] = 'Drupal\daedalus_layout\Element\LayoutBuilderPlus';
}

/**
 * Implements hook_library_info_alter().
 */
function daedalus_layout_library_info_alter(&$libraries, $extension) {
  // The selection verbs (Duplicate / Remove / Configure) register into the
  // edit-mode app's verb registry, so they ride its bundle as a dependency
  // rather than any tool's attachments.
  if ($extension === 'daedalus_ui' && isset($libraries['edit_mode'])) {
    $libraries['edit_mode']['dependencies'][] = 'daedalus_layout/verbs';
  }
}

/**
 * Implements hook_plugin_filter_TYPE_alter().
 */
function daedalus_layout_plugin_filter_block_alter(array &$definitions, array $extra, $consumer) {
  // The nested-section container plugin is dev-facing plumbing (a nested
  // section is addressed by its section uuid; the wrapper never surfaces).
  // Hide it from every plugin listing: placement flows through the blueprint
  // ops and Add panel, which construct container components directly.
  unset($definitions[SectionBlock::PLUGIN_ID]);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function daedalus_layout_form_entity_view_display_edit_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  \Drupal::classResolver(EntityViewDisplayForm::class)->formAlter($form, $form_state);
}

/**
 * Implements hook_system_breadcrumb_alter().
 */
function daedalus_layout_system_breadcrumb_alter(Breadcrumb &$breadcrumb, RouteMatchInterface $route_match, array $context) {
  \Drupal::classResolver(EntityViewDisplayForm::class)->breadCrumbAlter($breadcrumb, $route_match, $context);
}

/**
 * Implements hook_form_alter().
 */
function daedalus_layout_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  \Drupal::classResolver(OverridesEntityForm::class)->formAlter($form, $form_state, $form_id);
  \Drupal::service('daedalus_layout.form_alter.bundle_edit')->formAlter($form, $form_state);
  \Drupal::service('daedalus_layout.start_chooser')->formAlter($form, $form_state);
}

/**
 * Implements hook_entity_insert().
 */
function daedalus_layout_entity_insert(EntityInterface $entity) {
  if (\Drupal::moduleHandler()->moduleExists('block_content')) {
    \Drupal::classResolver(InlineBlockEntityOperations::class)->trackInlineBlockUsage($entity);
  }
}

/**
 * Implements hook_entity_update().
 */
function daedalus_layout_entity_update(EntityInterface $entity) {
  if (\Drupal::moduleHandler()->moduleExists('block_content')) {
    \Drupal::classResolver(InlineBlockEntityOperations::class)->trackInlineBlockUsage($entity);
  }
}
