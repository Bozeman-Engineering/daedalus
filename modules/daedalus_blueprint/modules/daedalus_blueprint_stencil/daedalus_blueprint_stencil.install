<?php

/**
 * @file
 * Install and update hooks for Daedalus Blueprint Stencil.
 */

declare(strict_types=1);

/**
 * Installs the stencil content entity type on existing sites.
 */
function daedalus_blueprint_stencil_update_10001(): void {
  \Drupal::entityDefinitionUpdateManager()->installEntityType(
    \Drupal::entityTypeManager()->getDefinition('stencil')
  );
}

/**
 * Installs the stencil-ownership field on daedalus_variant (existing sites).
 *
 * Only the update lane needs code: fresh installs are covered by core's
 * ModuleInstaller, which installs (and on uninstall removes) base field
 * storage definitions this module provides on other modules' entity types,
 * whichever module installs second.
 */
function daedalus_blueprint_stencil_update_10002(): void {
  if (!\Drupal::entityTypeManager()->hasDefinition('daedalus_variant')) {
    return;
  }
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($update_manager->getFieldStorageDefinition('stencil', 'daedalus_variant') !== NULL) {
    return;
  }
  $definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('daedalus_variant');
  if (isset($definitions['stencil'])) {
    $update_manager->installFieldStorageDefinition('stencil', 'daedalus_variant', 'daedalus_blueprint_stencil', $definitions['stencil']);
  }
}

/**
 * Installs the file-stencil ownership field on daedalus_variant.
 *
 * The stencil_file lane: file-shipped stencils have no entity for the
 * `stencil` reference to point at, so their owned variants store the owner
 * machine name (resolved against stencil discovery). Existing sites only;
 * fresh installs are covered by core's ModuleInstaller, exactly like the
 * `stencil` field (see daedalus_blueprint_stencil_update_10002()).
 */
function daedalus_blueprint_stencil_update_10003(): void {
  if (!\Drupal::entityTypeManager()->hasDefinition('daedalus_variant')) {
    return;
  }
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($update_manager->getFieldStorageDefinition('stencil_file', 'daedalus_variant') !== NULL) {
    return;
  }
  $definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('daedalus_variant');
  if (isset($definitions['stencil_file'])) {
    $update_manager->installFieldStorageDefinition('stencil_file', 'daedalus_variant', 'daedalus_blueprint_stencil', $definitions['stencil_file']);
  }
}

/**
 * Installs the origin field on stencils: who minted it (user or ai).
 *
 * Existing content stencils were minted by people (the AI lane stamps its
 * origin only from this release on), so the initial value "user" is the
 * truth for every existing row. File-shipped stencils are not entities;
 * their shipped origin is derived by the materials provider.
 */
function daedalus_blueprint_stencil_update_10004(): void {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($update_manager->getFieldStorageDefinition('origin', 'stencil') !== NULL) {
    return;
  }
  $definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('stencil');
  $update_manager->installFieldStorageDefinition('origin', 'stencil', 'daedalus_blueprint_stencil', $definitions['origin']);
}

/**
 * Installs the AI opt-out (ai_offered) on stencils.
 *
 * Every material is offered to the AI unless its author opts it out (the
 * AI's roster is the design system; hiding by default would empty it), so
 * the initial value is TRUE for every existing row. The daedalus_stylish materials
 * gained the same field in daedalus_stylish_update_10015().
 */
function daedalus_blueprint_stencil_update_10005(): void {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($update_manager->getFieldStorageDefinition('ai_offered', 'stencil') !== NULL) {
    return;
  }
  $definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('stencil');
  $update_manager->installFieldStorageDefinition('ai_offered', 'stencil', 'daedalus_blueprint_stencil', $definitions['ai_offered']);
}
