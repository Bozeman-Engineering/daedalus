<?php

/**
 * @file
 * Hooks for the Daedalus Edit module.
 */

use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Form\FormPreprocess;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyModuleImplementsAlter;
use Drupal\daedalus_blueprint_api\Render\SelectableKey;
use Drupal\daedalus_edit\EditIdentity;

/**
 * Implements hook_preprocess_HOOK().
 */
function daedalus_edit_preprocess_block(&$variables) {
  $variables['#cache']['contexts'][] = 'user.permissions';
  if ($variables['base_plugin_id'] !== 'inline_block') {
    return;
  }
  $entity = $variables['elements']['content']['#block_content'] ?? NULL;
  if ($entity === NULL) {
    return;
  }
  // Only a permitted user's output depends on the mode cookie: without the
  // permission both stamping branches resolve from the style map alone.
  $permitted = \Drupal::currentUser()->hasPermission('access inline editing');
  if ($permitted) {
    $variables['#cache']['contexts'][] = 'daedalus_ui_mode';
  }
  $editing = $permitted && \Drupal::service('daedalus_ui.ui')->getMode() === 'edit';

  // When the block label renders as page content (heading-style blocks force
  // label_display visible), it is a selectable element: the `label` property
  // of the placement. The key rides title_attributes — the title element
  // itself, not the editing wrapper div — because live renders have no
  // wrapper, and the @scope root must be the text element so Daedalus Stylish's
  // declarations compete with the theme's own h2/.block__title rules
  // directly instead of losing to them by inheritance. It is stamped as
  // field:{block_content_uuid}:label because the component UUID is not
  // visible at this point; daedalus_ui's InlineBlockFieldKeys rewrites
  // it to block:{component_uuid}:label at the block template boundary, the
  // same as inline-block field keys. Edit mode stamps unconditionally; a
  // live render stamps only when a provider demands the key (a styled
  // label), mirroring SelectableFieldDelivery.
  if (!empty($variables['label'])) {
    $selectable_key = SelectableKey::field($entity->uuid(), 'label');
    if ($editing || \Drupal::service('daedalus_ui.live_attribution_demand')->demandsKey($selectable_key, $entity)) {
      $variables['title_attributes'][SelectableKey::ATTRIBUTE] = $selectable_key;
    }
  }

  if (!$editing) {
    return;
  }
  // Allow block labels to be edited inline.
  // @see UpdateBlockForm
  $id = daedalus_ui_entity_identifier($entity);
  $view_mode = _daedalus_ui_get_view_mode($entity, $variables['content']['#view_mode']);
  $variables['daedalus_edit'] = [
    'id' => $id,
    'type' => $entity->getEntityTypeId(),
    'language' => $entity->language()->getId(),
    'view_mode' => $view_mode,
  ];
  $variables['title_prefix']['#markup'] = sprintf('<div data-daedalus-edit-field-value-wrapper="%s">', EditIdentity::fieldWrapperId($entity, 'label', EditIdentity::LABEL_PROPERTY));
  $variables['title_suffix']['#markup'] = '</div>';
  $variables['title_attributes']['class'][] = 'daedalus-edit-field-value';
  $variables['title_attributes']['data-daedalus-edit-id'] = EditIdentity::editId($entity, 'label', 0, $entity->language()->getId(), 'string', 'string', EditIdentity::LABEL_PROPERTY);
  $variables['title_attributes']['data-daedalus-edit-page-element-id'] = EditIdentity::itemId($entity, 'label', 0, EditIdentity::LABEL_PROPERTY);
}

/**
 * Implements hook_preprocess_HOOK() for page_title.
 *
 * The root row's edit target (the entity's label field, per the element
 * model's derived rule) often renders OUTSIDE the entity: the H1 is the
 * theme's page-title block. Stamp that render as the label field's editable
 * leaf so the root's edit route has something to open: the page-title twin
 * of the inline-block label attribution above.
 *
 * @see \Drupal\daedalus_edit\PageTitleEditing
 */
function daedalus_edit_preprocess_page_title(&$variables) {
  \Drupal::service('daedalus_edit.page_title_editing')->preprocessPageTitle($variables);
}

/**
 * Builds the cache tag invalidated when an entity's Daedalus Edit rendering changes.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity.
 *
 * @return string
 *   The cache tag.
 */
function daedalus_edit_cache_tag(EntityInterface $entity) {
  return sprintf('daedalus_edit:%s.%s', $entity->getEntityTypeId(), daedalus_ui_entity_identifier($entity));
}

/**
 * Implements hook_daedalus_blueprint_entity_persisted().
 *
 * Blueprint mutations (the endpoint verbs, AI tools) stage into the same
 * tempstore entry as inline form edits, but only the form path invalidated
 * the daedalus_edit render tag — so a full page load after a blueprint mutation
 * served the pre-mutation cached markup. Every editable render carries this
 * tag, so invalidating it here keeps reloads truthful for every persistence
 * path. The tag is daedalus_edit's own vocabulary, which is why the invalidation
 * lives here and not in daedalus_blueprint: the generic alternative would be
 * invalidating the entity's real cache tags, churning live-site caches for a
 * change that only exists in tempstore.
 */
function daedalus_edit_daedalus_blueprint_entity_persisted(EntityInterface $entity, bool $saved, array $component_uuids): void {
  Cache::invalidateTags([daedalus_edit_cache_tag($entity)]);
}

/**
 * Implements hook_entity_presave().
 *
 * Eager identity's universal backstop: whatever the write path (forms, REST,
 * migrations, blueprint persists), stored formatted text leaves this hook
 * with every vocabulary element carrying an s-* identity class. The
 * stage-time seam (EventSubscriber\FieldAppliedMintIdentity) covers blueprint
 * mutations that stage into tempstore without a save; this hook is the
 * guarantee for everything that does save. A format that allows a vocabulary
 * tag but strips its class attribute leaves that tag unminted rather than
 * failing the save (IdentityMinter's rules); Hook\DaedalusEditRequirements
 * names such formats on the status report.
 */
function daedalus_edit_entity_presave(EntityInterface $entity): void {
  if ($entity instanceof FieldableEntityInterface) {
    \Drupal::service('daedalus_edit.entity_identity_minting')->mintEntity($entity);
  }
}

/**
 * Implements hook_form_alter().
 */
function daedalus_edit_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (\Drupal::service('daedalus_ui.ui')->getMode() !== 'edit') {
    return;
  }
  if ($form_state->get('daedalus_edit_form')) {
    \Drupal::service('daedalus_edit.form_alter.inline_entity_form')->formAlter($form, $form_state);
  }
  else {
    \Drupal::service('daedalus_edit.form_alter.entity_edit')->formAlter($form, $form_state);
    // The Configure dialogs (registered with daedalus_layout).
    foreach (['daedalus_edit.form_alter.lb_block', 'daedalus_edit.form_alter.lb_section'] as $dialog) {
      if (\Drupal::hasService($dialog)) {
        \Drupal::service($dialog)->formAlter($form, $form_state, $form_id);
      }
    }
  }
}

