/**
 * Implements hook_module_implements_alter().
 */
#[LegacyModuleImplementsAlter]
function daedalus_edit_module_implements_alter(&$implementations, $hook) {
  if ($hook === 'form_alter' && isset($implementations['daedalus_edit'])) {
    unset($implementations['daedalus_edit']);
    $implementations['daedalus_edit'] = FALSE;
  }
}

/**
 * Implements hook_theme().
 */
function daedalus_edit_theme($existing, $type, $theme, $path) {
  return [
    'inline_textarea' => [
      'render element' => 'element',
      'initial preprocess' => '_daedalus_edit_preprocess_inline_textarea',
    ],
  ];
}

/**
 * Prepares variables for the inline textarea template.
 *
 * Default template: inline-textarea.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - element: An associative array containing the properties of the element.
 *    Properties used: #title, #value, #description, #rows, #cols, #maxlength,
 *    #placeholder, #required, #attributes, #resizable.
 */
function _daedalus_edit_preprocess_inline_textarea(&$variables) {
  \Drupal::service(FormPreprocess::class)->preprocessTextarea($variables);
  $attributes = $variables['attributes'];
  $attributes->addClass('daedalus-edit-hidden');
}

/**
 * Active tempstore entities.
 *
 * Flags that we have swapped this entity with a tempstore version.
 *
 * @param \Drupal\Core\Entity\EntityInterface|null $entity
 *   The entity that has been swapped or NULL to only retrieve the swapped
 *   entities.
 *
 * @return array|mixed
 *   An array of entities active in the tempstore.
 */
function daedalus_edit_active_tempstore_entities(?EntityInterface $entity = NULL) {
  $swapped_entities = &drupal_static(__FUNCTION__);
  if (empty($swapped_entities)) {
    $swapped_entities = [];
  }
  if (!empty($entity)) {
    $key = $entity->getEntityTypeId() . '.' . $entity->id();
    $swapped_entities[$key] = $entity;
  }
  return $swapped_entities;
}

/**
 * Implements hook_element_info_alter().
 *
 * Extends the functionality of text_format elements (provided by Filter
 * module), so that selecting a text format notifies a client-side text editor
 * when it should be enabled or disabled.
 *
 * @see \Drupal\filter\Element\TextFormat
 */
function daedalus_edit_element_info_alter(&$types) {
  $types['inline_textarea']['#pre_render'][] = 'element.daedalus_edit:preRenderTextFormat';
}

/**
 * Implements hook_form_FORM_ID_alter() for the 'field_config_edit' form ID.
 */
function daedalus_edit_form_field_config_edit_form_alter(&$form, FormStateInterface $form_state, $form_id): void {
  \Drupal::service('daedalus_edit.field_config_form_alter')->formAlter($form, $form_state);
}
