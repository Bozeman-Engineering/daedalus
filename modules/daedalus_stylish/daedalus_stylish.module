<?php

/**
 * @file
 * Daedalus Stylish module hooks.
 */

declare(strict_types=1);

use Drupal\Core\Cache\Cache;
use Drupal\Core\Config\Entity\ConfigEntityBundleBase;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Render\Element;
use Drupal\daedalus_blueprint\Materials\MaterialKind;
use Drupal\daedalus_blueprint_api\Render\SelectableKey;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Markup;
use Drupal\layout_builder\Entity\LayoutBuilderEntityViewDisplay;
use Drupal\daedalus_stylish\AnimationStylesheet;
use Drupal\daedalus_stylish\DefaultsStylesheet;
use Drupal\daedalus_stylish\StyleMapValidator;
use Drupal\daedalus_stylish\DaedalusStylishAnimationInterface;
use Drupal\daedalus_stylish\DaedalusStylishFieldManager;
use Drupal\daedalus_stylish\DaedalusStylishSkinInterface;
use Drupal\daedalus_stylish\DaedalusStylishSwatchInterface;
use Drupal\daedalus_stylish\DaedalusStylishVariantInterface;
use Drupal\daedalus_stylish\SwatchStylesheet;
use Drupal\daedalus_stylish\VariantStylesheet;

/**
 * Implements hook_form_alter().
 */
function daedalus_stylish_form_alter(&$form, FormStateInterface $form_state, $form_id): void {
  \Drupal::service('daedalus_stylish.form_alter.bundle_edit')->formAlter($form, $form_state);
}

/**
 * Implements hook_entity_view().
 *
 * Delivers a styled entity's CSS by embedding the style backend's output in
 * the entity's own build: it renders inside the entity's wrapper markup, so
 * it rides the entity's render cache (style edits invalidate via ordinary
 * entity tags — no new cache contexts) and travels with every subtree swap,
 * covering all mutation paths without CSS in the response contract.
 */
function daedalus_stylish_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  // Nested Layout Builder content render-caches as its own fragment
  // (block_content view), but its live attribution is answered by the ROOT
  // entity's style map — so the fragment must depend on the root: styling a
  // nested element saves the root, which must rebuild the nested markup that
  // carries (or now needs) the @scope root attributes.
  if ($entity->getEntityTypeId() === 'block_content' && \Drupal::hasService('daedalus_layout.root_entity_registry')) {
    $root = \Drupal::service('daedalus_layout.root_entity_registry')->getRoot($entity);
    if ($root instanceof FieldableEntityInterface && $root->hasField(DaedalusStylishFieldManager::FIELD_NAME)) {
      $build['#cache']['tags'] = Cache::mergeTags($build['#cache']['tags'] ?? [], $root->getCacheTags());
      // Nested Layout Builder sections build inside this fragment, but their
      // block/section/region keys — and therefore their variant references —
      // live on the ROOT map, so the class stamps are resolved from it here.
      $root_item = $root->get(DaedalusStylishFieldManager::FIELD_NAME)->first();
      _daedalus_stylish_stamp_variant_classes($build, $root_item?->getStyleMap() ?? []);
    }
  }

  if (!$entity instanceof FieldableEntityInterface || !$entity->hasField(DaedalusStylishFieldManager::FIELD_NAME)) {
    return;
  }
  $item = $entity->get(DaedalusStylishFieldManager::FIELD_NAME)->first();
  $map = $item?->getStyleMap() ?? [];
  if ($map === []) {
    return;
  }
  $addition = \Drupal::service('daedalus_stylish.style_backend')->build($entity, $map);
  if ($addition !== []) {
    $build['daedalus_stylish_css'] = $addition;
  }

  // Variant LIVE delivery at an ELEMENT key: an on-variant element carries
  // a variant class stamped at render, and its CSS arrives via the compiled
  // shared stylesheet, the "daedalus_stylish/variants" library, whose
  // definition resolves the current hash-busted file at library-discovery
  // time, so cached renders never pin a stale filename. Classes are
  // live-only delivery: in edit mode a variant is a preset, resolved inline
  // at its data-selectable key root instead
  // (VariantStylesheet::editModeInlineCss()). Wear at a RULE key
  // ("{key}::{selector}") rides no class in any mode: its matches are many,
  // so the variant's fragment prints inside the rule's own @scope through
  // VariantStylesheet::ruleWearCss(), part of the style backend's addition
  // above (CssStyleBackend::build(), before the map's own CSS so an own
  // value beats a worn one by order). The stamps below still land where
  // they can in edit mode (entity root, fields): inert double delivery of
  // identical CSS, kept unconditional so the stamped markup itself never
  // varies by mode.
  _daedalus_stylish_stamp_variant_classes($build, $map);
  // The entity root's classes ride the entity template's own root element
  // in every mode (the walk above runs before the entity-root stamp below,
  // so the root is classed directly here), one class per reference in
  // axis-declaration order.
  foreach (\Drupal::service('daedalus_stylish.style_map_validator')->orderedEntryRefs($map[SelectableKey::entity($entity->uuid())] ?? NULL) as $ref) {
    _daedalus_stylish_add_class($build, VariantStylesheet::fragmentClass($ref['variant'], $ref['fragment']));
  }
  if (_daedalus_stylish_map_has_variant_refs($map)) {
    $build['#attached']['library'][] = 'daedalus_stylish/variants';
    $build['#cache']['tags'][] = VariantStylesheet::CACHE_TAG;
    // Edit mode resolves the references INLINE into the entity's style tag,
    // key-rooted (the canvas never carries variant classes — see
    // VariantStylesheet::editModeInlineCss()), so a render with refs varies
    // by the effective mode. Added in every mode: a live render cached
    // without the context would otherwise answer edit-mode requests too.
    $build['#cache']['contexts'][] = 'daedalus_ui_mode';
    if (\Drupal::hasService('workspaces.manager')) {
      // Workspace previews inline the referenced variants' staged CSS into
      // the entity's style tag (the preview edge), so the render varies by
      // workspace. Added unconditionally when workspaces exists: a live
      // render cached without the context would otherwise answer workspace
      // requests too.
      $build['#cache']['contexts'][] = 'workspace';
    }
  }

  // The entity root's @scope root: the entity key rides the entity's own
  // markup root (core merges a build's #attributes into the template's
  // {{ attributes }}; block_content has no entity template, so its stamp is
  // hoisted onto the wrapping block template's root by
  // BlockViewBuilder::preRender()): bytes on an existing element, no
  // wrapper. Stamped in EVERY mode: daedalus_ui stamps the same
  // attribute and value on the same build for editors (for block_content
  // only when it is the ROOT on its standalone editing surface; nested and
  // region-placed blocks are attributed at their placement instead), so the
  // writes are idempotent and live, browsing, and edit mode all target ONE
  // identical root (no mode cache variance, no double-root, no edit/live
  // divergence).
  $entity_key = SelectableKey::entity($entity->uuid());
  $has_entity_styles = array_filter(array_keys($map), fn (string $key) => $key === $entity_key || str_starts_with($key, $entity_key . '::')) !== [];
  if ($has_entity_styles) {
    $build['#attributes'][SelectableKey::ATTRIBUTE] = $entity_key;
  }
}

/**
 * Implements hook_preprocess_HOOK() for field templates.
 *
 * Stamps an entity field's variant class, at preprocess because field
 * template attributes are not built from the render array. LIVE delivery
 * (edit mode resolves the reference key-rooted inline instead; the class
 * landing there too is inert double delivery of identical CSS, stamped
 * unconditionally so field markup never varies by mode). Only fields of a
 * map HOST are covered: an inline block's fields reference variants under
 * "block:{component_uuid}:{name}" keys whose component uuid is unknowable
 * at field render; stamping a class by field
 * name would visibly style same-named fields of other blocks, so
 * block-field variant references do not deliver live yet.
 */
function daedalus_stylish_preprocess_field(&$variables): void {
  $element = $variables['element'] ?? [];
  $entity = $element['#object'] ?? NULL;
  if (!$entity instanceof FieldableEntityInterface || empty($element['#field_name'])) {
    return;
  }
  if (!$entity->hasField(DaedalusStylishFieldManager::FIELD_NAME)) {
    return;
  }
  $map = $entity->get(DaedalusStylishFieldManager::FIELD_NAME)->first()?->getStyleMap() ?? [];
  $entry = $map[SelectableKey::field($entity->uuid(), (string) $element['#field_name'])] ?? NULL;
  foreach (\Drupal::service('daedalus_stylish.style_map_validator')->orderedEntryRefs($entry) as $ref) {
    $class = VariantStylesheet::fragmentClass($ref['variant'], $ref['fragment']);
    if ($class !== NULL) {
      $variables['attributes']['class'][] = $class;
    }
  }
}

/**
 * Implements hook_library_info_build().
 *
 * The "daedalus_stylish/variants" library delivers the compiled variant
 * stylesheet. The file is hash-busted per compile, so the library NAME is
 * the stable thing renders attach; the current filename is resolved here,
 * at library-discovery time, and VariantStylesheet::compile() invalidates
 * library_info. The library exists even with no compiled file (attaching a
 * missing library is an error; an asset-less library is not).
 *
 * Each compiled file's library key is its DRUPAL_ROOT-relative path
 * (CompiledStylesheetBase::libraryPath(), '/sites/<site>/files/...'), not a
 * browser URL: core treats a leading-slash key as DRUPAL_ROOT-relative and
 * prepends base_path() itself at render, so a generated URL (which already
 * carries base_path()) would double it on any subdirectory install.
 */
function daedalus_stylish_library_info_build(): array {
  // A variant may bind its animation to a motion trigger; the runtime that
  // polyfills the trigger (daedalus_stylish/motion_triggers) rides wherever the
  // variant stylesheet does.
  $libraries['variants'] = ['css' => ['theme' => []], 'dependencies' => ['daedalus_stylish/motion_triggers']];
  $path = \Drupal::service('daedalus_stylish.variant_stylesheet')->libraryPath();
  if ($path !== NULL) {
    // User-authored variant CSS must win the cascade the same way the inline
    // per-entity styles do: unlayered. Without the exemption daedalus_stylish_layers
    // wraps this file into the site layer, where theme specificity beats it
    // again.
    $libraries['variants']['css']['theme'][$path] = [
      'preprocess' => FALSE,
      'daedalus_stylish_layers_exempt' => TRUE,
    ];
  }
  // The "daedalus_stylish/defaults" library delivers the compiled defaults
  // stylesheet (the declared tier, then the active skin's tokens and
  // defaults), the exact posture of the variants library above:
  // hash-busted file resolved at discovery time, unlayered so token
  // definitions cannot lose to a theme's own custom-property declarations
  // at higher specificity.
  $libraries['defaults'] = ['css' => ['theme' => []]];
  $path = \Drupal::service('daedalus_stylish.defaults_stylesheet')->libraryPath();
  if ($path !== NULL) {
    $libraries['defaults']['css']['theme'][$path] = [
      'preprocess' => FALSE,
      'daedalus_stylish_layers_exempt' => TRUE,
      // The defaults file must sort BEFORE the variants file: defaults and
      // variant CSS meet at identical :scope specificity on the same
      // elements, and document order must let the explicit variant choice
      // beat the default.
      'weight' => -10,
    ];
  }
  // The "daedalus_stylish/swatches" library delivers the compiled swatch stylesheet
  // (the palette's custom properties), same posture again.
  $libraries['swatches'] = ['css' => ['theme' => []]];
  $path = \Drupal::service('daedalus_stylish.swatch_stylesheet')->libraryPath();
  if ($path !== NULL) {
    $libraries['swatches']['css']['theme'][$path] = [
      'preprocess' => FALSE,
      'daedalus_stylish_layers_exempt' => TRUE,
      // Before the defaults file (-10) and the variants file (0): skin
      // tokens and variant values may reference swatches, so the palette's
      // definitions lead the delivered document (see SwatchStylesheet).
      'weight' => -20,
    ];
  }
  // The "daedalus_stylish/animations" library delivers the compiled animations
  // stylesheet (the named @keyframes at-rules), same posture again.
  // Every page carrying the keyframes carries the motion-triggers runtime:
  // any element wearing an animation may bind it to a trigger.
  $libraries['animations'] = ['css' => ['theme' => []], 'dependencies' => ['daedalus_stylish/motion_triggers']];
  $path = \Drupal::service('daedalus_stylish.animation_stylesheet')->libraryPath();
  if ($path !== NULL) {
    $libraries['animations']['css']['theme'][$path] = [
      'preprocess' => FALSE,
      'daedalus_stylish_layers_exempt' => TRUE,
      // After the swatch file (-20), before the defaults file (-10):
      // keyframe steps may reference swatches, and defaults and variants
      // may wear animations, so the definitions sit between the two in the
      // delivered document (see AnimationStylesheet).
      'weight' => -15,
    ];
  }
  return $libraries;
}

/**
 * Implements hook_page_attachments().
 *
 * Defaults delivery is PAGE-scoped, not entity-scoped: tokens are site
 * vocabulary and defaults address every element of a scope, delivered on
 * every frontend page regardless of what renders, so its seam is core's
 * page-scoped asset seam, hook_page_attachments(), not hook_entity_view()
 * and not hook_page_top(): attachments carry #attached and #cache only,
 * bubble onto the page (HtmlRenderer::invokePageAttachmentHooks) and reach
 * the chromeless documents (preview mode) whose page_top daedalus_ui nulls
 * whole (DaedalusUiHooks::preprocessHtml). Attach the
 * "daedalus_stylish/defaults" library (asset-less when nothing is compiled;
 * attaching a missing library is an error, an asset-less one is not) and
 * carry the recompile tag so skin saves, design-system switches and
 * declaration changes reach cached pages. The swatch file (the palette's
 * custom properties) and the animations file (the named @keyframes
 * at-rules) ride the same seam with the same anatomy.
 *
 * Documents the skin does not reach (admin-theme pages, pop-outs; see
 * _daedalus_stylish_skinless_document()) carry no token scope element, so
 * every selector in the compiled files is dead there: skipping the attach
 * saves the request (correctness comes from the scope element, this is
 * only optimization).
 *
 * Inside a workspace the active skin's (possibly staged) revision, the
 * staged palette and the staged keyframes inline per page at the same
 * scope-class selectors (the preview edge at page level). The tags print
 * from the scope-element preprocess
 * (daedalus_stylish_preprocess_off_canvas_page_wrapper()), a seam that
 * cannot bubble cacheability, so the cache side lives here: the workspace
 * cache context whenever workspaces exists (a page cached without it would
 * otherwise answer workspace requests too) and each service's
 * workspaceInlineCss() tags, so staged edits invalidate the page. Two
 * prints per request inside an active workspace (the tags here, the text
 * there), by design: a per-request memo goes stale when the skin is saved
 * between the two calls.
 */
function daedalus_stylish_page_attachments(array &$attachments): void {
  if (_daedalus_stylish_skinless_document()) {
    return;
  }
  $attachments['#attached']['library'][] = 'daedalus_stylish/defaults';
  $attachments['#attached']['library'][] = 'daedalus_stylish/swatches';
  $attachments['#attached']['library'][] = 'daedalus_stylish/animations';
  $tags = [
    DefaultsStylesheet::CACHE_TAG,
    'config:daedalus_stylish.settings',
    SwatchStylesheet::CACHE_TAG,
    AnimationStylesheet::CACHE_TAG,
  ];
  if (\Drupal::hasService('workspaces.manager')) {
    $attachments['#cache']['contexts'] = Cache::mergeContexts($attachments['#cache']['contexts'] ?? [], ['workspace']);
    foreach (array_keys(_daedalus_stylish_workspace_previews()) as $service) {
      \Drupal::service($service)->workspaceInlineCss($tags);
    }
  }
  $attachments['#cache']['tags'] = Cache::mergeTags($attachments['#cache']['tags'] ?? [], $tags);
}

/**
 * Implements hook_preprocess_HOOK() for the off-canvas page wrapper.
 *
 * Stamps the TOKEN SCOPE ELEMENT: the wrapper the compiled defaults
 * stylesheet scopes every token definition to
 * (DefaultsStylesheet::SCOPE_CLASS). Tokens
 * deliver on an element, not :root, because width-conditioned values
 * compile as @container queries and container queries cannot style the
 * query container itself: the definitions need an element just INSIDE the
 * nearest width container. (The file's one :root rule is the scheme
 * declaration, CssPrinter::COLOR_SCHEME_RULE, a UA-rendering fact the
 * viewport reads from the root alone, not a token.) This wrapper sits
 * exactly there in both modes:
 * inside #daedalus-ui-stage for editors (daedalus_stylish's preprocess runs
 * BEFORE daedalus_ui's, daedalus_stylish_theme_registry_alter(), so the stage
 * wraps this element), and directly inside the off-canvas canvas (the live
 * width container the compiled file declares on demand) for everyone else.
 *
 * The scope element is the SINGLE reach boundary for all defaults output
 * (the declared tier and both skin tiers print inside it), so its
 * placement decides where the skin exists
 * (_daedalus_stylish_skinless_document()): it is not stamped when the
 * active theme is the configured admin theme (a skin is the SITE's look,
 * and user-authored styling data must never be able to degrade the admin
 * refuge, which daedalus_stylish_layers would otherwise let it beat
 * structurally), nor on a pop-out route (a tool window the editing page
 * opens beside itself, whose bare tags are the tool's, not the site's).
 * Everything downstream (scope classes, the compiled files, AJAX fragments)
 * is inert without it, and dialogs attach to <body> outside it, so modal
 * chrome is structurally unreachable on any page. The theme check reads
 * config a preprocess cannot bubble; render cache already varies by theme,
 * and re-pointing system.theme's admin theme without a rebuild is the
 * accepted stale edge. Otherwise stamped unconditionally: the markup is
 * static (no skin lookup), and an inert wrapper div costs nothing on
 * skinless sites.
 *
 * Inside a workspace the staged previews print here, as the scope
 * element's first children: a <style> per service that has staged CSS
 * (data-daedalus-stylish-defaults-preview, -swatch-preview,
 * -animation-preview; the attributes identify the preview tags for
 * reconciliation and debugging, mirroring the per-entity
 * data-daedalus-stylish-entity attribute). The scope element is then
 * literally the one place every defaults output lives, and the tags sit
 * in <body>, later in the document than the compiled <link>s in <head>,
 * so the staged CSS wins the cascade for identical selectors and the
 * later @keyframes definition of a name takes effect. Their cacheability
 * (the workspace context, the staged entities' tags) is
 * daedalus_stylish_page_attachments()'s.
 */
function daedalus_stylish_preprocess_off_canvas_page_wrapper(&$variables): void {
  if (empty($variables['children']) || _daedalus_stylish_skinless_document()) {
    return;
  }
  $previews = '';
  if (\Drupal::hasService('workspaces.manager')) {
    foreach (_daedalus_stylish_workspace_previews() as $service => $attribute) {
      $tags = [];
      $css = \Drupal::service($service)->workspaceInlineCss($tags);
      if ($css !== '') {
        // The printer is the emit gate; Xss::filterAdmin would mangle CSS.
        $previews .= '<style ' . $attribute . '>' . "\n" . $css . "\n" . '</style>';
      }
    }
  }
  $variables['children'] = Markup::create(
    '<div class="' . DefaultsStylesheet::SCOPE_CLASS . '">' . $previews . $variables['children'] . '</div>'
  );
}

/**
 * The workspace preview services, keyed by id, valued by their tag attribute.
 *
 * Print order: the skin, the palette, the keyframes.
 */
function _daedalus_stylish_workspace_previews(): array {
  return [
    'daedalus_stylish.defaults_stylesheet' => 'data-daedalus-stylish-defaults-preview',
    'daedalus_stylish.swatch_stylesheet' => 'data-daedalus-stylish-swatch-preview',
    'daedalus_stylish.animation_stylesheet' => 'data-daedalus-stylish-animation-preview',
  ];
}

/**
 * Whether the skin does not reach the current document.
 *
 * The skin's reach gate, the one predicate both the scope-element
 * preprocess and the attachments hook read. Two documents are outside
 * the skin's reach:
 * - Admin-theme pages: active THEME, not route-based admin context, since
 *   admin routes can render in the frontend theme and vice versa, and the
 *   theme is what carries the design system the skin must not fight. An
 *   empty admin theme setting (site uses its default theme for admin)
 *   gates nothing: that is the site's own choice to have one look
 *   everywhere.
 * - Pop-outs (daedalus_ui.chromeless, the _daedalus_ui.popout route
 *   option): a tool window the editing page opens beside itself (the
 *   responsive preview shell, the inspector satellite), not a site page.
 *   The skin is the site's look; delivered into a pop-out it would restyle
 *   the tool's own bare tags. Preview mode is NOT gated: the preview
 *   iframe's document is a site page with the editor gone, and the skin is
 *   what it previews.
 */
function _daedalus_stylish_skinless_document(): bool {
  $admin_theme = \Drupal::config('system.theme')->get('admin');
  if (is_string($admin_theme) && $admin_theme !== ''
    && \Drupal::theme()->getActiveTheme()->getName() === $admin_theme) {
    return TRUE;
  }
  return \Drupal::service('daedalus_ui.chromeless')->isPopout();
}

/**
 * Implements hook_theme_registry_alter().
 *
 * Orders daedalus_stylish's off-canvas wrapper preprocess BEFORE daedalus_ui's.
 * Both wrap $variables['children'], so execution order is nesting order:
 * daedalus_stylish first means the token scope element ends up INSIDE the stage
 * (#daedalus-ui-stage), which is the edit-mode width container — the
 * posed canvas width can then flip width-conditioned tokens. Module order
 * runs daedalus_ui first (alphabetical at equal weight), which would
 * strand the scope OUTSIDE the stage, where its @container queries answer
 * to the viewport-tracking live container instead of the canvas.
 */
function daedalus_stylish_theme_registry_alter(&$theme_registry): void {
  $functions = &$theme_registry['off_canvas_page_wrapper']['preprocess functions'];
  if (!is_array($functions)) {
    return;
  }
  $daedalus_stylish = array_search('daedalus_stylish_preprocess_off_canvas_page_wrapper', $functions, TRUE);
  $daedalus_ui = array_search('daedalus_ui_preprocess_off_canvas_page_wrapper', $functions, TRUE);
  if ($daedalus_stylish !== FALSE && $daedalus_ui !== FALSE && $daedalus_ui < $daedalus_stylish) {
    array_splice($functions, $daedalus_stylish, 1);
    array_splice($functions, $daedalus_ui, 0, 'daedalus_stylish_preprocess_off_canvas_page_wrapper');
  }
}

/**
 * Stamps variant classes onto build elements carrying a referencing key.
 *
 * The element addressed by a variant-reference map key needs the variant
 * class in its markup; that is the whole LIVE delivery, since the
 * CSS ships in the compiled stylesheet. Sections, regions and blocks carry
 * their selectable keys in their render arrays (stamped at build time by the
 * daedalus_layout/daedalus_ui seams — in edit mode always, live exactly when
 * demanded, and a variant reference IS demand), so the class rides wherever
 * the key was stamped. Rule keys ("{key}::{selector}") are skipped: a
 * rule's matches are many and carry no one stampable element, so its wear
 * prints inside the rule's own @scope in every mode
 * (VariantStylesheet::ruleWearCss()), never as a class.
 *
 * The walk is live-only in effect, by timing: live Layout Builder sections
 * build eagerly in LayoutBuilderEntityViewDisplay::buildMultiple(), BEFORE
 * hook_entity_view, so their subtrees are here to stamp; in edit mode they
 * build inside the canvas element's #pre_render, AFTER this hook, so the
 * walk finds nothing. Edit mode never relies on classes anyway; its
 * references resolve key-rooted into the entity's authoritative style tag
 * (VariantStylesheet::editModeInlineCss()).
 */
function _daedalus_stylish_stamp_variant_classes(array &$build, array $map): void {
  $classes = [];
  $validator = \Drupal::service('daedalus_stylish.style_map_validator');
  foreach ($map as $key => $entry) {
    // A rule key wears inline at its own @scope in every mode
    // (VariantStylesheet::ruleWearCss()); only element keys class-stamp.
    if (str_contains((string) $key, '::')) {
      continue;
    }
    // One class per reference, stamped in axis-declaration order
    // (StyleMapValidator::orderedEntryRefs()) so the markup is
    // deterministic regardless of the order variants were applied in. A
    // {variant, fragment} reference stamps its (variant, fragment) class:
    // composition children are ordinary entries, and their fragment's CSS
    // waits in the compiled file under that class.
    foreach ($validator->orderedEntryRefs($entry) as $ref) {
      $class = VariantStylesheet::fragmentClass($ref['variant'], $ref['fragment']);
      if ($class !== NULL) {
        $classes[(string) $key][] = $class;
      }
    }
  }
  if ($classes !== []) {
    _daedalus_stylish_walk_stamp($build, $classes);
  }
}

/**
 * Recursively applies key => class stamps through a render array.
 */
function _daedalus_stylish_walk_stamp(array &$build, array $classes): void {
  $key = $build['#attributes'][SelectableKey::ATTRIBUTE] ?? NULL;
  if (is_string($key) && isset($classes[$key])) {
    foreach ($classes[$key] as $class) {
      _daedalus_stylish_add_class($build, $class);
    }
  }
  foreach (Element::children($build) as $child) {
    if (is_array($build[$child])) {
      _daedalus_stylish_walk_stamp($build[$child], $classes);
    }
  }
}

/**
 * Adds a class to a render array's #attributes once.
 */
function _daedalus_stylish_add_class(array &$build, ?string $class): void {
  if ($class !== NULL && !in_array($class, (array) ($build['#attributes']['class'] ?? []), TRUE)) {
    $build['#attributes']['class'][] = $class;
  }
}

/**
 * Whether a style map holds any variant references.
 */
function _daedalus_stylish_map_has_variant_refs(array $map): bool {
  foreach ($map as $entry) {
    if (StyleMapValidator::entryVariants($entry) !== []) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Implements hook_entity_insert().
 */
function daedalus_stylish_entity_insert(EntityInterface $entity): void {
  _daedalus_stylish_gate_check($entity);
  _daedalus_variant_change($entity);
  _daedalus_skin_change($entity);
  _daedalus_swatch_change($entity);
  _daedalus_animation_change($entity);
  _daedalus_stylish_media_change($entity);
  _daedalus_stylish_usage_track($entity);
  _daedalus_stylish_value_usage_track($entity);
}

/**
 * Implements hook_entity_update().
 */
function daedalus_stylish_entity_update(EntityInterface $entity): void {
  _daedalus_stylish_gate_check($entity);
  _daedalus_variant_change($entity);
  _daedalus_skin_change($entity);
  _daedalus_swatch_change($entity);
  _daedalus_animation_change($entity);
  _daedalus_stylish_media_change($entity);
  _daedalus_stylish_usage_track($entity);
  _daedalus_stylish_value_usage_track($entity);
}

/**
 * Implements hook_entity_delete().
 */
function daedalus_stylish_entity_delete(EntityInterface $entity): void {
  _daedalus_variant_change($entity);
  _daedalus_skin_change($entity);
  _daedalus_swatch_change($entity);
  _daedalus_animation_change($entity);
  _daedalus_stylish_media_change($entity);
  if ($entity instanceof FieldableEntityInterface && $entity->hasField(DaedalusStylishFieldManager::FIELD_NAME)) {
    \Drupal::service('daedalus_stylish.variant_usage')->untrack($entity);
  }
  if (_daedalus_stylish_value_usage_source($entity)) {
    \Drupal::service('daedalus_stylish.swatch_usage')->untrack($entity);
    \Drupal::service('daedalus_stylish.animation_usage')->untrack($entity);
  }
  // A deleted bundle takes its opt-out record with it, so a future bundle
  // reusing the machine name defaults ON like any other new bundle. Config
  // sync is exempt: it must not modify config outside the sync set (a stale
  // record is inert anyway).
  if ($entity instanceof ConfigEntityBundleBase && !$entity->isSyncing()) {
    $bundle_of = $entity->getEntityType()->getBundleOf();
    if ($bundle_of !== NULL) {
      \Drupal::service('daedalus_stylish.field_manager')->clearOptOut($bundle_of, $entity->id());
    }
  }
}

/**
 * Implements hook_modules_installed().
 *
 * Activates the shipped definitions of the just-installed modules (their
 * MODULE.daedalus_stylish.animations.yml / swatches / skins / variants.yml and the
 * per-id files beside them; see ShippedDefinitionsImporter) through the
 * one orchestrator, and, when daedalus_stylish itself is in the batch, every
 * enabled module's. ModuleInstaller does not rebuild all caches, so
 * install is its own entry beside hook_rebuild(). Runs during config sync
 * too: shipped definitions are content belonging to the module's code, so
 * enabling the module through a config import must produce the same
 * styled site as enabling it by hand. During a site install a batch
 * before the recipe's activation waits, silently (the activation lands
 * it), and a batch after it syncs at install (see ShippedSync).
 * The installed modules' declarations (and any declared
 * defaults among them) land the same way (_daedalus_stylish_declarations_changed()),
 * after the sync so a shipped skin landing in the batch compiles once
 * with its declarations.
 */
function daedalus_stylish_modules_installed(array $modules, bool $is_syncing): void {
  \Drupal::service('daedalus_stylish.shipped_sync')->onInstall($modules);
  _daedalus_stylish_declarations_changed();
}

/**
 * Implements hook_modules_uninstalled().
 *
 * An uninstalled module takes its declarations with it: the declared tier
 * of the defaults stylesheet recompiles without them.
 */
function daedalus_stylish_modules_uninstalled(array $modules, bool $is_syncing): void {
  _daedalus_stylish_declarations_changed();
}

/**
 * Implements hook_themes_installed().
 *
 * A theme may restate a module's declared defaults (it owns the markup
 * model); its declaration files join the layering when it is installed.
 */
function daedalus_stylish_themes_installed($theme_list): void {
  _daedalus_stylish_declarations_changed();
}

/**
 * Implements hook_themes_uninstalled().
 */
function daedalus_stylish_themes_uninstalled(array $themes): void {
  _daedalus_stylish_declarations_changed();
}

/**
 * Recompiles the defaults stylesheet after the declaration set changed.
 *
 * The one reaction behind every extension event (module and theme install
 * and uninstall, the cache rebuild): the guide drops its built
 * declarations first (the persistent declarations cache with them, so the
 * compile reads the new layering, not a memo built before the change),
 * then the defaults stylesheet recompiles; content-addressed, so a batch
 * that changed no declaration touches nothing but cache tags. The
 * design-system switch is the same reaction in DesignSystemSwitchSubscriber
 * (a package's declarations layer only while its system is active) and a
 * default-theme change in DefaultsSettingsSubscriber.
 */
function _daedalus_stylish_declarations_changed(): void {
  \Drupal::service('daedalus_stylish.style_guide')->resetCache();
  \Drupal::service('daedalus_stylish.defaults_stylesheet')->compile();
}

/**
 * Implements hook_rebuild().
 *
 * Activates every enabled module's shipped definitions at the end of
 * drupal_flush_all_caches(), so `drush cr`, the UI's clear-all, `drush
 * updb`, and site install all bring a pulled package live in one step
 * (the way a module's stencil file already goes live through discovery).
 * A deliberate departure from core's install-and-update-hooks-only
 * posture; see ShippedSync for the reasoning, the pending-entity-updates
 * guard, and the log. The defaults stylesheet recompiles behind the same
 * guard: a rebuild is where pulled declaration changes (a module's new
 * declared defaults, a theme's restatement) go live, and the compile reads
 * the entity storages the guard protects.
 */
function daedalus_stylish_rebuild(): void {
  if (\Drupal::service('daedalus_stylish.shipped_sync')->onRebuild()) {
    _daedalus_stylish_declarations_changed();
  }
}

/**
 * Recompiles the shared variant stylesheet when a variant changes.
 *
 * Compilation always reads the live default revisions — a save inside a
 * workspace leaves the file unchanged (its staged CSS previews via the
 * inline fallback) but still invalidates the consumers, which is harmlessly
 * broad. Workspace PUBLISH is covered by VariantWorkspaceSubscriber because
 * publishing does not fire per-entity update hooks.
 */
function _daedalus_variant_change(EntityInterface $entity): void {
  if ($entity instanceof DaedalusStylishVariantInterface) {
    // The resolved-reference identity map must not outlive the write: a
    // gesture that saves a variant and re-resolves it in the same request
    // (push, save-as-variant re-attach) reads the fresh entity.
    \Drupal::service('daedalus_stylish.variant_repository')->reset();
    // The conformance verdict memoizes with the repository: the saved
    // entity is judged afresh under the current law (its persistent entry
    // rides the list tag this write invalidates).
    \Drupal::service('daedalus_stylish.variant_conformance')->reset();
    // The materials roster memoizes the published set per request; the
    // same write must not leave it holding the pre-write roster.
    \Drupal::service('daedalus_blueprint.materials_roster_builder')->reset();
    // The write rides the response's materials delta: by id only, the
    // delta resolves upsert vs remove against the fresh roster.
    \Drupal::service('daedalus_blueprint.materials_change_set')->touch(MaterialKind::Variant, $entity->getMachineName());
    // Both resets come first: the compile reads the published set from the
    // roster and the entities through the identity map.
    \Drupal::service('daedalus_stylish.variant_stylesheet')->compile();
  }
}

/**
 * Recompiles the defaults stylesheet when a skin changes.
 *
 * The skin counterpart of _daedalus_variant_change(): compilation always
 * reads the live default revision — a save inside a workspace leaves the
 * file unchanged (its staged CSS previews via the page-level inline
 * fallback) but still invalidates the consumers, harmlessly broad, and a
 * save of an INACTIVE skin recompiles to an identical file. Workspace
 * PUBLISH is covered by SkinWorkspaceSubscriber; a design-system switch
 * by DesignSystemSwitchSubscriber and threshold changes by
 * DefaultsSettingsSubscriber.
 */
function _daedalus_skin_change(EntityInterface $entity): void {
  if ($entity instanceof DaedalusStylishSkinInterface) {
    // The materials roster carries the active skin's tokens, and the
    // validator's token universe and the compiled file's token walk are
    // the roster's: a skin change mid-request (an AI batch minting a
    // token, then writing a style that references it) must see the fresh
    // universe, and the compile below must read the post-write tokens.
    \Drupal::service('daedalus_blueprint.materials_roster_builder')->reset();
    // Tokens are materials of the ACTIVE skin only (token ids are not skin
    // qualified: "{scale}/{name}" names the active skin's token), so only
    // its write rides the response's materials delta: every token id the
    // skin carried before and carries now, upsert vs remove resolved
    // against the fresh roster (an unpublish removes them all).
    if (\Drupal::service('daedalus_stylish.skin_manager')->activeSkinName() === $entity->getMachineName()) {
      $provider = \Drupal::service('daedalus_stylish.materials_provider');
      $original = $entity->getOriginal();
      \Drupal::service('daedalus_blueprint.materials_change_set')->touch(
        MaterialKind::Token,
        ...$provider->tokenIds($entity),
        ...($original instanceof DaedalusStylishSkinInterface ? $provider->tokenIds($original) : []),
      );
    }
    \Drupal::service('daedalus_stylish.defaults_stylesheet')->compile();
  }
}

/**
 * Recompiles the swatch stylesheet when a swatch changes.
 *
 * The swatch counterpart of _daedalus_variant_change(): compilation always
 * reads the live default revisions — a save inside a workspace leaves the
 * file unchanged (its staged CSS previews via the page-level inline
 * fallback) but still invalidates the consumers, harmlessly broad.
 * Workspace PUBLISH is covered by SwatchWorkspaceSubscriber. There is
 * deliberately NO daedalus_stylish.settings chokepoint: the compile builds the
 * materials roster, whose provider queries the daedalus_stylish storages, which do
 * not exist yet when default config imports at module install (the
 * variants posture, see DefaultsSettingsSubscriber's docblock).
 *
 * The repository reset mirrors _daedalus_variant_change()'s: the
 * resolved-reference memo and the published-name universe must not outlive
 * the write, so a gesture that mints a swatch and validates a value
 * referencing it in the same request sees the fresh universe.
 */
function _daedalus_swatch_change(EntityInterface $entity): void {
  if ($entity instanceof DaedalusStylishSwatchInterface) {
    \Drupal::service('daedalus_stylish.swatch_repository')->reset();
    // The materials roster memoizes the published set per request; the
    // same write must not leave it holding the pre-write roster.
    \Drupal::service('daedalus_blueprint.materials_roster_builder')->reset();
    // The write rides the response's materials delta: by id only, the
    // delta resolves upsert vs remove against the fresh roster.
    \Drupal::service('daedalus_blueprint.materials_change_set')->touch(MaterialKind::Swatch, $entity->getMachineName());
    \Drupal::service('daedalus_stylish.swatch_stylesheet')->compile();
  }
}

/**
 * Recompiles the animations stylesheet when an animation changes.
 *
 * The animation counterpart of _daedalus_swatch_change(), same posture in
 * every respect: compilation always reads the live default revisions (a
 * save inside a workspace leaves the file unchanged and previews via the
 * page-level inline fallback), workspace PUBLISH is covered by
 * AnimationWorkspaceSubscriber, no daedalus_stylish.settings chokepoint, and the
 * repository reset comes first so a gesture that mints an animation and
 * wears it in the same request sees the fresh universe.
 */
function _daedalus_animation_change(EntityInterface $entity): void {
  if ($entity instanceof DaedalusStylishAnimationInterface) {
    \Drupal::service('daedalus_stylish.animation_repository')->reset();
    // The materials roster memoizes the published set per request; the
    // same write must not leave it holding the pre-write roster.
    \Drupal::service('daedalus_blueprint.materials_roster_builder')->reset();
    // The write rides the response's materials delta: by id only, the
    // delta resolves upsert vs remove against the fresh roster.
    \Drupal::service('daedalus_blueprint.materials_change_set')->touch(MaterialKind::Animation, $entity->getMachineName());
    \Drupal::service('daedalus_stylish.animation_stylesheet')->compile();
  }
}

/**
 * Recompiles the shared variant stylesheet when referenced media changes.
 *
 * A media token in a compiled variant resolves to a concrete file URL baked
 * into the static stylesheet, and cache tags cannot bust a static file, so
 * updating (file replace, new URL), deleting (degrade to "none"), or
 * inserting (a deleted media restored under its uuid, swapping "none" back
 * for the URL) a media entity the compiled variants reference recompiles
 * it. A variant referencing media that never existed does not reach the
 * sheet: the judge refuses it at save. The gate is the raw-token uuid list
 * the last compile recorded (VariantStylesheet::MEDIA_STATE_KEY);
 * unreferenced media saves cost one state read. Media referenced by ENTITY
 * MAPS needs no hook: the resolver bubbles the media's cache tags into the
 * host's render cache entry.
 */
function _daedalus_stylish_media_change(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'media') {
    return;
  }
  if (\Drupal::service('daedalus_stylish.variant_stylesheet')->referencesMedia((string) $entity->uuid())) {
    \Drupal::service('daedalus_stylish.variant_stylesheet')->compile();
  }
  // The defaults stylesheet bakes resolved media URLs too (skin defaults
  // may reference media), with its own recorded reference list.
  if (\Drupal::service('daedalus_stylish.defaults_stylesheet')->referencesMedia((string) $entity->uuid())) {
    \Drupal::service('daedalus_stylish.defaults_stylesheet')->compile();
  }
}

/**
 * Keeps the daedalus_variant_usage table in step with a saved map host.
 *
 * The map field's save chokepoint: every style map write (op spine,
 * blueprint write, programmatic save) ends in a host entity save, so this
 * hook pair is the ONE maintenance point of the usage table every usage
 * consumer reads (VariantUsage). Default revisions only, matching what a
 * push affects: the compiled stylesheet live pages load.
 */
function _daedalus_stylish_usage_track(EntityInterface $entity): void {
  if ($entity instanceof FieldableEntityInterface && $entity->hasField(DaedalusStylishFieldManager::FIELD_NAME)) {
    \Drupal::service('daedalus_stylish.variant_usage')->track($entity);
  }
}

/**
 * Keeps the value-level usage tables in step with a saved source entity.
 *
 * The variant chokepoint's hard twin, for both value-level references:
 * swatch references (var(--swatch-*)) and animation references (the
 * motion-{name} keyframes ident in a motion property) live inside CSS
 * VALUES across the same THREE stores, so the one maintenance point
 * listens on three entity families — map hosts (every style map write
 * ends in a host save), variants (styles), and skins (tokens and site
 * defaults) — and each table's track() dispatches by source kind. Default
 * revisions only, matching what a material edit restyles: the live custom
 * property, the live keyframes.
 */
function _daedalus_stylish_value_usage_track(EntityInterface $entity): void {
  if (_daedalus_stylish_value_usage_source($entity)) {
    \Drupal::service('daedalus_stylish.swatch_usage')->track($entity);
    \Drupal::service('daedalus_stylish.animation_usage')->track($entity);
  }
}

/**
 * Whether an entity is a value-usage source: the cheap pre-service gate.
 *
 * Mirrors the usage services' own dispatch (ValueUsageBase::sourceKind())
 * so unrelated saves never instantiate them; each service re-derives the
 * kind itself, so the reads cannot drift in effect, only in cost.
 */
function _daedalus_stylish_value_usage_source(EntityInterface $entity): bool {
  return $entity instanceof DaedalusStylishVariantInterface
    || $entity instanceof DaedalusStylishSkinInterface
    || ($entity instanceof FieldableEntityInterface && $entity->hasField(DaedalusStylishFieldManager::FIELD_NAME));
}

/**
 * Auto-enables styling whenever the default-on gate is open.
 *
 * Styling defaults ON for bundles with Layout Builder AND Edit Mode
 * enabled. This watches every save of a gate carrier, a bundle config entity
 * (daedalus_ui's edit-mode status) or a view display (Layout Builder),
 * and re-checks the gate each time, no transition detection: opt-out memory
 * lives in the explicit daedalus_stylish.settings opt_outs record (consulted by
 * maybeAutoEnable), not in whether a save happened to flip the gate. So a
 * deliberately disabled bundle stays disabled through re-saves AND gate
 * re-toggles, while a bundle that merely missed its enablement moment
 * converges at the next save. Config sync is exempt: it must not create
 * config outside the sync set.
 */
function _daedalus_stylish_gate_check(EntityInterface $entity): void {
  if ($entity instanceof ConfigEntityBundleBase && !$entity->isSyncing()) {
    $bundle_of = $entity->getEntityType()->getBundleOf();
    if ($bundle_of !== NULL) {
      \Drupal::service('daedalus_stylish.field_manager')->maybeAutoEnable($bundle_of, $entity->id());
    }
  }

  if ($entity instanceof LayoutBuilderEntityViewDisplay && !$entity->isSyncing()) {
    \Drupal::service('daedalus_stylish.field_manager')->maybeAutoEnable($entity->getTargetEntityTypeId(), $entity->getTargetBundle());
  }
}

/**
 * Implements hook_daedalus_blueprint_ai_bundle_list_alter().
 *
 * Skins are the AI's site-wide styling lever (tokens restyle everything at
 * once). Seeing the token vocabulary is unconditional (the tokens fragment
 * in every style guide); OPERATING on skins follows the acting account's
 * 'administer skins' permission, the same access skin CRUD enforces, so
 * the AI surface mirrors the permission model instead of pretending to be
 * one. Hidden types are refused by every daedalus_blueprint_ai tool, so for
 * accounts without the permission the AI can neither list nor touch
 * daedalus_skin entities.
 */
function daedalus_stylish_daedalus_blueprint_ai_bundle_list_alter(array &$bundle_list): void {
  if (!\Drupal::currentUser()->hasPermission('administer skins')) {
    unset($bundle_list['daedalus_skin']);
  }
  elseif (isset($bundle_list['daedalus_skin']['bundles']['daedalus_skin'])) {
    // The bundle description is the AI's first contact with the skin
    // concept; it routes the AI to the skins skill before it improvises.
    $bundle_list['daedalus_skin']['bundles']['daedalus_skin']['description'] =
      "The site's look as data: design-token values and site-wide element defaults. One skin is active sitewide. Invoke the skins skill before creating or editing skins.";
  }
  // Swatches are ungated (editor vocabulary, entity access is the
  // permission model); the description is the AI's first contact with the
  // palette concept and routes it to the material gestures the design
  // system brief's MINT line teaches, never to an entity write.
  if (isset($bundle_list['daedalus_swatch']['bundles']['daedalus_swatch'])) {
    $bundle_list['daedalus_swatch']['bundles']['daedalus_swatch']['description'] =
      'A palette swatch: a named CSS value (kinds color and gradient) referenced from styles as var(--swatch-{machine_name}). Published swatches are live site-wide; the design system brief lists them under NAMED VALUES. Mint and edit one through the material gestures (save_material, update_material, remove_material with kind swatch, page_edit ops; the brief\'s MINT line carries the keys), never through an entity write.';
  }
  // Animations likewise: the motion material, ungated (entity access is
  // the permission model); the description routes the AI to the material
  // gestures and the wear (animation-name) before it improvises a
  // keyframes block.
  if (isset($bundle_list['daedalus_animation']['bundles']['daedalus_animation'])) {
    $bundle_list['daedalus_animation']['bundles']['daedalus_animation']['description'] =
      'An animation: a named @keyframes block (steps: offsets mapping CSS properties to values) worn from styles as animation-name: motion-{machine_name}. Published animations are live site-wide; the design system brief lists them under ANIMATIONS. Mint and edit one through the material gestures (save_material, update_material, remove_material with kind animation, page_edit ops; the brief\'s MINT line carries the keys), never through an entity write; never write @keyframes into a style.';
  }
}
