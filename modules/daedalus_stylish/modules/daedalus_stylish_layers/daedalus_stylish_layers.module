<?php

/**
 * @file
 * Daedalus Stylish Layers module hooks.
 */

declare(strict_types=1);

use Drupal\Core\Cache\Cache;

/**
 * Implements hook_page_attachments().
 *
 * (hook_css_alter() lives in \Drupal\daedalus_stylish_layers\Hook\CssHooks: it needs
 * the OOP #[Hook] attribute's order, Order::Last, which has no procedural
 * equivalent that is not deprecated.)
 *
 * Emits the cascade layer-order statement as the first stylesheet content in
 * the document: `@layer daedalus_stylish_force, <wrapper>;`. The FIRST occurrence of a
 * layer name establishes layer order, so this must precede every pipeline
 * stylesheet (which the decorators wrap in the wrapper layer). html_head
 * elements render into head-placeholder, which core, Olivero and Claro
 * html.html.twig all place BEFORE css-placeholder — verified against the
 * templates and live render. Weight -999 keeps it directly after the charset
 * meta (-1000, which must stay first for security) and ahead of everything
 * else in html_head.
 */
function daedalus_stylish_layers_page_attachments(array &$attachments): void {
  /** @var \Drupal\daedalus_stylish_layers\Layers $layers */
  $layers = \Drupal::service('daedalus_stylish_layers.layers');
  $config = \Drupal::config('daedalus_stylish_layers.settings');

  // Rendered pages vary on this config whether or not the statement is
  // emitted, so always attach its cacheability.
  $attachments['#cache']['tags'] = Cache::mergeTags(
    $attachments['#cache']['tags'] ?? [],
    $config->getCacheTags(),
  );

  if (!$layers->isEnabled()) {
    return;
  }

  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'style',
      '#value' => $layers->getOrderStatement(),
      '#weight' => -999,
    ],
    'daedalus_stylish_layers_layer_order',
  ];
}
