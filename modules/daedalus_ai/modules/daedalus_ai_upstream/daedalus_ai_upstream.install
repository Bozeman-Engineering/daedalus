<?php

/**
 * @file
 * Update hooks for the interim Anthropic provider plugin's settings.
 */

declare(strict_types=1);

/**
 * Retires the per-turn-block switch from the settings.
 *
 * The per-turn blocks are always text inside the user message now: the
 * API's form that clears a system message at the next user-role message
 * was leg-scoped in a tool loop (cleared at the first tool_result) and its
 * saving was a tenth of the blocks' price per leg.
 */
function daedalus_ai_upstream_update_11101(): void {
  \Drupal::configFactory()
    ->getEditable('daedalus_ai_upstream.settings')
    ->clear('turn_scoped_instructions')
    ->save(TRUE);
}

/**
 * Adds the thinking display setting, omitted (the API's default) on a site.
 *
 * The setting is a diagnostic. Its summarized value asks the API for the
 * model's reasoning summary in the thinking blocks of each response; the
 * transcript keeps those blocks and the ai_logging rows carry them, so a
 * site that wants to read along can. The model thinks and is billed the
 * same either way; only visibility changes. An existing site gets omitted,
 * so its records keep the shape they had.
 */
function daedalus_ai_upstream_update_11102(): void {
  $config = \Drupal::configFactory()->getEditable('daedalus_ai_upstream.settings');
  if ($config->get('thinking_display') === NULL) {
    $config->set('thinking_display', 'omitted')->save(TRUE);
  }
}
