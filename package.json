{
  "name": "daedalus",
  "private": true,
  "scripts": {
    "test": "node --test \"modules/*/tests/js/*.test.mjs\"",
    "build:dev": "webpack --config modules/daedalus_ui/webpack.config.js --config modules/daedalus_stylish/webpack.config.js --mode development",
    "watch:dev": "webpack --config modules/daedalus_ui/webpack.config.js --config modules/daedalus_stylish/webpack.config.js --watch --mode development",
    "build:prod": "webpack --config modules/daedalus_ui/webpack.config.js --config modules/daedalus_stylish/webpack.config.js --mode production",
    "watch:prod": "webpack --config modules/daedalus_ui/webpack.config.js --config modules/daedalus_stylish/webpack.config.js --watch --mode production",
    "generate:wide-properties": "node modules/daedalus_stylish/js/src/tools/generate-wide-properties.mjs",
    "vendor-update": "drush daedalus_edit:update-ckeditor-version; npm install; drush daedalus_edit:move-library"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.5",
    "@reduxjs/toolkit": "^2.7.0",
    "css-tree": "^3.2.1",
    "lodash": "^4.17.21",
    "mdn-data": "2.27.1",
    "preact": "^10.26.5",
    "react-redux": "^8.1.3",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@ckeditor/ckeditor5-editor-inline": "~47.3.0",
    "babel-loader": "^10.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.99.6",
    "webpack-cli": "^6.0.1"
  }
}
